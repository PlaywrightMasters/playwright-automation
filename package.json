{
  "name": "toolshop-playwright-framework",
  "version": "1.0.0",
  "description": "Layered Playwright + TypeScript test automation framework for the Practice Software Testing (Toolshop) e-commerce app: UI, API, hybrid, accessibility and visual tests.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:a11y": "playwright test --grep @a11y --project=chromium",
    "test:visual": "playwright test --grep @visual --project=chromium",
    "test:visual:update": "playwright test --grep @visual --project=chromium --update-snapshots",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report reports/html-report",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:allure:open": "allure open reports/allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "allure-commandline": "2.46.1",
    "allure-playwright": "3.14.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  }
}
