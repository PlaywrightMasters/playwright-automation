# Copy to .env to override defaults. .env is git-ignored.

# Storefront under test. Point at https://with-bugs.practicesoftwaretesting.com
# to run the same suite against the intentionally buggy build.
BASE_URL=https://practicesoftwaretesting.com

# REST API of the same application.
API_URL=https://api.practicesoftwaretesting.com

# Optional AI failure analysis (off by default).
# When AI_ANALYSIS=true and Anthropic credentials are available (ANTHROPIC_API_KEY,
# or an `ant auth login` profile), failed tests are classified by Claude.
# Otherwise a local heuristic produces the same report shape.
AI_ANALYSIS=false
AI_MODEL=claude-opus-5-5
# Leave commented out unless you use a key: an empty value can hide an
# `ant auth login` profile from the SDK.
# ANTHROPIC_API_KEY=
